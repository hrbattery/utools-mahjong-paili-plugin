{
  "name": "utools-mahjong-paili-plugin",
  "version": "1.0.0",
  "description": "uTools 日麻牌理速查：本地截图识牌、向听数与有效进张分析",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/copy-notices.mjs",
    "test": "node --test tests/*.test.ts",
    "test:ui": "npm run build && node --test tests/ui.test.mjs",
    "samples:tenhou": "node scripts/create-tenhou-samples.ts",
    "samples:majsoul": "node scripts/prepare-majsoul-samples.ts",
    "templates:prepare": "node scripts/prepare-recognition-templates.ts",
    "test:recognition-samples": "node scripts/evaluate-local-recognition.ts",
    "test:recognition-real": "node scripts/review-real-screenshots.ts",
    "test:recognition-holdout": "node scripts/review-real-screenshots.ts --holdout",
    "build:engine": "cargo build --manifest-path engine/Cargo.toml --target wasm32-unknown-unknown --release && node scripts/copy-engine.mjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
